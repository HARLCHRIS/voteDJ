# Supabase (obligatoire)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sécurité Anti-Bot (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Hachage côté serveur (sel cryptographique pour IP et tokens d'appareil)
DEVICE_HASH_SALT=change-me-in-production-with-32-char-random-string

# Rate Limiting (Upstash Redis - optionnel en dev local)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_SECRET=

